# ==========================================
# 1. Authentication
# ==========================================

### Register Patient
# @name registerPatient
POST {{host}}/auth/register
Content-Type: application/json

{
  "email": "{{patient_email}}",
  "password": "{{password}}",
  "role": "patient"
}

### Login Patient
# @name loginPatient
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{patient_email}}",
  "password": "{{password}}"
}

### Save the returned token
# @authToken = {{loginPatient.response.body.access_token}}
###




### Register Clinician
# @name registerClinician
POST {{host}}/auth/register
Content-Type: application/json

{
  "email": "{{clinician_email}}",
  "password": "{{password}}",
  "role": "clinician"
}

### Login Clinician
# @name loginClinician
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{clinician_email}}",
  "password": "{{password}}"
}

### Save clinician token


# ==========================================
# 2. Patient Profile & Vitals
# ==========================================
# Note: Replace `patient_uuid_here` in routes below with a real UUID
# obtained during registration/login (available in DB or JWT sub payload).

### Create or Update Patient Intake Profile
POST {{host}}/patient/8c99afa3-5842-41e7-86b3-28477fd0c195/profile
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "age": 58,
  "gender": "male",
  "race": "white",
  "height": 172.0,
  "weight": 86.5,
  "systolic_bp": 142,
  "diastolic_bp": 88,
  "fasting_blood_glucose": 118.0,
  "family_history_cardiovascular": true,
  "family_history_diabetes": true,
  "active_medications": ["warfarin", "lisinopril"],
  "allergies": ["penicillin"],
  "lifestyle_smoke": true,
  "lifestyle_active": false,
  "alcohol_consumption": "moderate",
  "sleep_duration": 6.0,
  "sleep_quality": "poor",
  "tobacco_consumption": "daily",
  "past_operations": ["appendix removal"],
  "medical_history": ["gout"]
}

### Get Patient Profile
GET {{host}}/patient/{{patientId}}/profile
Authorization: Bearer {{authToken}}

### Log Vital Log Entry (Hypertensive Crisis values)
POST {{host}}/patient/{{patientId}}/vitals
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "systolic_bp": 185,
  "diastolic_bp": 125,
  "blood_sugar": 260.0,
  "creatinine": 1.2,
  "heart_rate": 95
}

# ==========================================
# 3. Clinical Queries (Multi-Turn Loops)
# ==========================================

### Send Query with Missing Information (Start Turn 1)
# Since the query lacks duration, the system replies asking for details.
# @name initialQuery
POST {{host}}/query
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "text": "I feel some stomach pain"
}



# Complete the multi-turn session with answers
POST {{host}}/query
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "text": "It started this morning",
  "session_id": "{{sessionId}}"
}

### Send Urgent Query (Bypasses clarification loops for safety)
POST {{host}}/query
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "text": "I have sudden severe crushing chest pain since 15 minutes"
}

# ==========================================
# 4. Reports Ingestion & Confirmation
# ==========================================

### Upload Lab Report (PDF or Image)
# Replace 'C:/path/to/report.pdf' below with the path to a real PDF or image report on your computer to test extraction.
POST {{host}}/reports/upload
Authorization: Bearer {{authToken}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="my_report.pdf"
Content-Type: application/pdf

< C:/path/to/report.pdf
--boundary--

### Confirm low-confidence report extraction
# Replace `report_uuid_here` with a real Report UUID from upload or DB
POST {{host}}/reports/report_uuid_here/confirm
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "confirm": true,
  "corrected_values": {
    "blood_sugar": 140.0,
    "systolic_bp": 130,
    "diastolic_bp": 82
  }
}

### Get Patient History (Vitals, Reports, Inferences)
GET {{host}}/patient/{{patientId}}/history
Authorization: Bearer {{authToken}}

# ==========================================
# 5. Clinician Dashboard
# ==========================================

### Clinician view escalations
GET {{host}}/clinician/escalations
Authorization: Bearer {{clinicianToken}}

# ==========================================
# 6. Service Health Check
# ==========================================

### Liveness check
GET {{host}}/health
